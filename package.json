{
  "name": "3dmine-osgb-to-3dtile",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "3DMine(osgb转3dtile工具)",
  "author": "3dmine-cn",
  "license": "MIT",
  "private": true,
  "keywords": [
    "osgb",
    "3dtiles",
    "cesium",
    "gis",
    "electron",
    "vue"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:vite": "vite build",
    "build:tool": "tsc -p tsconfig.tool.json && node scripts/write-tool-wrappers.cjs",
    "build:tool:exe": "vite build --config vite.tool.config.ts && node scripts/build-tool-exe.cjs",
    "build:win": "vue-tsc --noEmit && vite build && cross-env ELECTRON_SKIP_BINARY_DOWNLOAD=1 electron-builder --win --config electron-builder.json",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^7.0.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.1.0",
    "3dm-im-components": "file:./vendor/3dm-im-components",
    "cesium": "1.121.0",
    "echarts": "5.4.3",
    "element-plus": "2.3.14",
    "jquery": "3.7.1",
    "mars3d": "3.7.22",
    "mars3d-cesium": "1.119.0",
    "pinia": "^2.2.0",
    "vue": "3.5.35",
    "vue-router": "^4.0.0"
  }
}
