{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.3dmine.osgb2tiles.converter",
  "asar": true,
  "productName": "3DMine(osgb转3dtile工具)",
  "directories": {
    "output": "release/${version}"
  },
  "files": ["dist", "dist-electron"],
  "extraResources": [
    {
      "from": "public/3dtile",
      "to": "3dtile"
    },
    {
      "from": "public/cesium-preview.html",
      "to": "cesium-preview.html"
    },
    {
      "from": "public/cesium",
      "to": "cesium"
    }
  ],
  "electronDist": "node_modules/electron/dist",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "icon": "public/logo.png",
    "signExecutable": false,
    "signExts": []
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "packElevateHelper": false,
    "shortcutName": "3DMine(osgb转3dtile工具)",
    "uninstallDisplayName": "3DMine(osgb转3dtile工具)",
    "warningsAsErrors": false
  }
}
